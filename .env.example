# Windows: double-click CHAY_DEMO.bat to create/configure .env automatically.
# Manual: copy this file to .env next to compose.yaml. No quotes, no export.
GOOGLE_CLIENT_ID=configure-client-id
GOOGLE_CLIENT_SECRET=configure-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8080/login/oauth2/code/google
# Used to generate links in BOTH notification emails.
APP_BASE_URL=http://localhost:8080
SERVER_PORT=8080
# Browser API key restricted to Google Picker API + Google Drive API.
GOOGLE_API_KEY=
# Numeric project NUMBER, not project ID.
GOOGLE_PROJECT_NUMBER=
DRIVE_FOLDER_ID=
# Automatic roles from exact email domains; verified Google Workspace identity required.
AUTO_DOMAIN_ROLES=true
# Checked before domain rules. Leave empty to disable the demo exception.
LECTURER_OVERRIDE_EMAIL=524h0133@student.tdtu.edu.vn
# Legacy admission settings used only when AUTO_DOMAIN_ROLES=false.
AUTO_STUDENT_LOGIN=true
# Optional legacy allowlist. Required when both automatic modes are disabled.
STUDENT_EMAILS=
# Optional suggestions in automatic domain mode; explicit lecturers in legacy mode.
LECTURER_EMAILS=
# Checked against verified Google ID-token hd claim, not just the email suffix.
ALLOWED_WORKSPACE_DOMAINS=student.tdtu.edu.vn,tdtu.edu.vn
MAX_UPLOAD_MB=15
DISPLAY_TIMEZONE=Asia/Ho_Chi_Minh
COOKIE_SECURE=false
# Local metadata only. Docker preserves ./data using a named volume.
DATABASE_URL=jdbc:h2:file:./data/seminar;DB_CLOSE_ON_EXIT=FALSE
DATABASE_USER=sa
DATABASE_PASSWORD=

# Automatic Drive access: see DRIVE_SETUP.md. Existing .env without this setting stays MANUAL.
# ISOLATED: student-specific folder + lecturer access to each assigned file (recommended).
# SHARED: whole-class folder; requires owner acknowledgement in the setup page.
DRIVE_ACCESS_MODE=ISOLATED
DRIVE_ADMIN_EMAIL=
# CHAY_DEMO.bat generates this only when empty; existing valid keys are preserved.
# Manual: generate a UNIQUE random 32-byte Base64 key. Never commit the real .env.
DRIVE_ADMIN_TOKEN_KEY=
